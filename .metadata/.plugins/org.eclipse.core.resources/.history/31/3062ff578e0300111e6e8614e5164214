#include "open_interface.h"

double move_forward(oi_t *sensor_data, double distance_mm) {
    int i;
    int increment = 50;
    int sum = 0;
    int brake_distance = distance_mm * 0.9; //start slowing down here

    //Start building up speed slowly
    for (i = 1; i <= 10; i++) {
        oi_setWheels(i * increment, i * increment);
        sum = add_distance(sensor_data);
    }

    while (sum < brake_distance) {
        sum = add_distance(sensor_data);
    }

    for (i = 9; i >= 0; i--) {
            oi_setWheels(i * increment, i * increment);
            sum = add_distance(sensor_data);
        }

    oi_setWheels(0,0);
    return sum;
}

int add_distance(oi_t *sensor_data) {
    oi_update(sensor_data);
    sum += sensor_data -> distance;
    return sum
}

