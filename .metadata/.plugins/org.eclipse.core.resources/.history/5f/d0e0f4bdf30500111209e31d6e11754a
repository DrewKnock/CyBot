void move_square(oi_t *sensor_data, double distance_mm) {
	move_forward(sensor_data, distance_mm);
	turn_right(sensor_data, 90);

	move_forward(sensor_data, distance_mm);
	turn_right(sensor_data, 90);

	move_forward(sensor_data, distance_mm);
	turn_right(sensor_data, 90);

	move_forward(sensor_data, distance_mm);
	turn_right(sensor_data, 90);
}
